# SQLite file for the AppView index and app sessions
DATABASE_URL=data/george.db
# Public origin of this app. http://localhost:5173 selects the atproto loopback OAuth client for dev.
APP_URL=http://localhost:5173
# JSON array of private JWKs (ES256) for the confidential OAuth client. Generate with `pnpm keygen`.
# Not needed for the loopback (dev) client.
OAUTH_PRIVATE_KEYS=
# Set to 0 to not run the firehose indexer in this process
INDEXER=1
# Override the OAuth scope (default: atproto + repo:<nsid> for each george collection)
# OAUTH_SCOPE=atproto transition:generic
