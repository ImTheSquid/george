# SQLite file for all data
DATABASE_URL=data/george.db
# Public origin; also the WebAuthn relying-party id (hostname). Dev: http://localhost:5173
APP_URL=http://localhost:5173
# Require an invite code to sign up (default 1). The first code is printed at startup.
INVITE_REQUIRED=1
# Single-use invite codes each user may create (default 0). Admins can override per user.
INVITE_QUOTA_DEFAULT=0
